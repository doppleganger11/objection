# Leave PAYPAL_* empty to run with the clearly labelled simulated PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only. This app refuses any other PayPal host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Without this the hearing uses a scripted, clearly labelled fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

HEARINGS_PER_HOUR=30
PORT=3000
